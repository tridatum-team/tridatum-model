<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SITE-RECOVERY-010: interim test.tridatum.co origin on the MacBook (the Mac mini could not hold the model server
     without a memory-pressure warning). Serves the pinned deployed commit's service (TRID_DEMO_SERVICE) on 127.0.0.1:51873
     with no quick tunnel; co.tridatum.trid.site.tunnel publishes it on the fixed named-tunnel origin the Worker uses.
     launchd restarts it when it exits, so the 168 h supervise lease no longer takes the site down. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>co.tridatum.trid.site</string>
  <key>WorkingDirectory</key><string>/Users/eomgyuhyeon/사업/trid</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/eomgyuhyeon/사업/trid/.venv/bin/python</string>
    <string>scripts/share_demo_control.py</string>
    <string>supervise</string>
    <string>--hours</string>
    <string>168</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TRID_DEMO_TUNNEL</key><string>0</string>
    <key>TRID_DEMO_SERVICE</key><string>/Users/eomgyuhyeon/사업/trid/scripts/shared_demo_live_9256df4.py</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/eomgyuhyeon/사업/trid/.shared-demo/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/eomgyuhyeon/사업/trid/.shared-demo/launchd.log</string>
</dict>
</plist>
